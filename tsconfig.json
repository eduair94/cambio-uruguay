{
    "compilerOptions": {
        "module": "commonjs",
        "moduleResolution": "bundler",
        "pretty": true,
        "sourceMap": true,
        "target": "es2021",
        "rootDir": ".",
        "outDir": "./dist",
        "esModuleInterop": true,
        "lib": ["dom", "es2021"],
        "types": ["node"],
        "strict": false,
        "resolveJsonModule": true,
        "skipLibCheck": true
    },
    "include": ["./**/*.ts"],
    "exclude": ["**/node_modules", "app", "dist", "mcp", "bots", "scripts/oneoff"]
}
