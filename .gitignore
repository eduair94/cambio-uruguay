# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

package-lock.json
# CI (deploy.yml) installs app/ with `npm install` — NOT `npm ci` — but keys the
# npm cache on this lockfile, so it must be committed even though every other
# package-lock.json stays ignored.
!app/package-lock.json

# Server-side deploy stamp: the hash of the dependency set the server last
# installed, so deploy.sh can skip npm install when nothing changed.
app/.deps-stamp
dist
sheet_key.json
serviceAccount.json
# GA4 Data API service-account key (docs/analytics/GA4_DATA_API.md). The second pattern catches a
# key downloaded straight from Google Cloud, which arrives named `<project>-<keyid>.json` — one of
# those landed in this directory untracked, one `git add -A` away from a live private key in a
# public repo.
ga4_key.json
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json
.env
# Copias del .env (`.env.bak-20260922-cf` estaba suelta en la raíz, con secretos, sin ignorar). Las
# plantillas que sí van al repo son `.env.sample` y `*/.env.example`.
.env.*
!.env.sample
!.env.example

proxy.txt
oca_session.json
prex_session.txt
prex_login_attempt.txt
santander_session.json
santander_session.json.*.tmp
scotiabank_session.json
last_sync.txt
.output
proxy_scrape.json

# Scratch / scraping snapshots dumped at repo root (HTML/PNG/JSON debug artifacts)
/*.html
/*.png
# Lo mismo un nivel adentro: los agentes que investigan contra fuente primaria bajan
# páginas y PDFs y los dejan en el cwd, que muchas veces es app/. El fixture real vive
# en app/tests/fixtures/, así que sólo se ignora la raíz de app/.
/app/*.html
/app/*.png
indumex_preview.json
indumex_reviews.json
rev.json
rev2.json
regul-snapshot.yml
/*_snapshot.yml
/births.json
/bonda-catalog.json
/ifttt-activity.yml
/serp-*.txt
/tmp-*.ts
/t[0-9].sh
# Redirecciones de cmd.exe hechas desde Git Bash (`> nul`, `2>&9`): crean archivos de verdad.
/nul
/&[0-9]

# Carpeta de trabajo de los agentes: copias enteras del árbol para el escaneo de gitleaks, previews
# de UI, logs de deploy y binarios bajados. El 14/11/2026 eran 48.600 archivos sin trackear, que
# tapaban los cambios reales en `git status`. Nada de esto es código.
.artifacts/
.codex-remote-attachments/

# Tooling scratch + crash dumps
.playwright-mcp/
*.stackdump
.sdd-*
.superpowers/
# SEO analysis private data + service-account keys (never commit)
docs/seo/data/
.agents
.claude
.serena
.github
# Bookkeeping for the quote-plausibility guard (classes/rate_plausibility.ts): one line per
# rejected quote per day, so the Telegram alert fires once instead of every five minutes.
rate_rejections.json
