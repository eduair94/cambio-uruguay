{
  "name": "cambio-uruguay-mcp",
  "version": "0.2.0",
  "mcpName": "io.github.eduair94/cambio-uruguay",
  "description": "Model Context Protocol server for Uruguay: exchange rates, rental search (household ranking, fair rent, neighbourhoods, opportunities), used cars and product prices from cambio-uruguay.com. Read-only, open source.",
  "type": "module",
  "license": "MIT",
  "author": "cambio-uruguay",
  "homepage": "https://cambio-uruguay.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eduair94/cambio-uruguay.git",
    "directory": "mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "uruguay",
    "exchange-rate",
    "dolar",
    "cotizacion",
    "casas-de-cambio",
    "alquileres",
    "alquiler",
    "autos-usados",
    "inmobiliaria",
    "precios",
    "real-estate",
    "used-cars"
  ],
  "bin": {
    "cambio-uruguay-mcp": "dist/index.js"
  },
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    },
    "./news": {
      "types": "./dist/news.d.ts",
      "import": "./dist/news.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/index.ts",
    "prepublishOnly": "npm run build",
    "smoke": "node scripts/smoke.mjs",
    "pack-skill": "node scripts/pack-skill.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0",
    "@types/node": "^20.14.0"
  }
}
