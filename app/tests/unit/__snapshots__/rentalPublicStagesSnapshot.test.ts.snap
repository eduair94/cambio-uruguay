exports[`rentalPublicStages: the stages every filter shares > with excluded adverts 1`] = `
[
  {
    "$set": {
      "offers": {
        "$filter": {
          "as": "offer",
          "cond": {
            "$and": [
              {
                "$eq": [
                  {
                    "$type": "$$offer.lastSeen",
                  },
                  "string",
                ],
              },
              {
                "$gte": [
                  "$$offer.lastSeen",
                  "2026-03-05",
                ],
              },
              {
                "$isNumber": "$$offer.priceUyu",
              },
              {
                "$gt": [
                  "$$offer.priceUyu",
                  0,
                ],
              },
              {
                "$not": [
                  {
                    "$in": [
                      {
                        "$let": {
                          "in": {
                            "$concat": [
                              "rent:",
                              "$$source",
                              ":",
                              {
                                "$cond": [
                                  {
                                    "$eq": [
                                      {
                                        "$indexOfCP": [
                                          "$$id",
                                          {
                                            "$concat": [
                                              "$$source",
                                              ":",
                                            ],
                                          },
                                        ],
                                      },
                                      0,
                                    ],
                                  },
                                  {
                                    "$substrCP": [
                                      "$$id",
                                      {
                                        "$add": [
                                          {
                                            "$strLenCP": "$$source",
                                          },
                                          1,
                                        ],
                                      },
                                      {
                                        "$strLenCP": "$$id",
                                      },
                                    ],
                                  },
                                  "$$id",
                                ],
                              },
                            ],
                          },
                          "vars": {
                            "id": {
                              "$convert": {
                                "input": "$$offer.listingId",
                                "onError": "",
                                "onNull": "",
                                "to": "string",
                              },
                            },
                            "source": {
                              "$convert": {
                                "input": "$$offer.source",
                                "onError": "",
                                "onNull": "",
                                "to": "string",
                              },
                            },
                          },
                        },
                      },
                      [
                        "rent:mercadolibre:MLU900100",
                        "rent:facebook:fb-aviso",
                        "rent:elpais:ep-7",
                      ],
                    ],
                  },
                ],
              },
            ],
          },
          "input": {
            "$cond": [
              {
                "$isArray": "$offers",
              },
              "$offers",
              [],
            ],
          },
        },
      },
    },
  },
  {
    "$match": {
      "offers.0": {
        "$exists": true,
      },
    },
  },
  {
    "$set": {
      "freshAt": {
        "$ifNull": [
          {
            "$max": "$offers.publishedAt",
          },
          {
            "$max": "$offers.firstSeen",
          },
        ],
      },
      "furnished": {
        "$cond": [
          {
            "$in": [
              true,
              "$offers.furnished",
            ],
          },
          {
            "$cond": [
              {
                "$in": [
                  false,
                  "$offers.furnished",
                ],
              },
              null,
              true,
            ],
          },
          {
            "$cond": [
              {
                "$in": [
                  false,
                  "$offers.furnished",
                ],
              },
              false,
              null,
            ],
          },
        ],
      },
      "guarantees": {
        "$reduce": {
          "in": {
            "$setUnion": [
              "$$value",
              {
                "$cond": [
                  {
                    "$isArray": "$$this.guarantees",
                  },
                  "$$this.guarantees",
                  [],
                ],
              },
            ],
          },
          "initialValue": [],
          "input": "$offers",
        },
      },
      "lastSeen": {
        "$max": "$offers.lastSeen",
      },
      "matchingOffer": {
        "$reduce": {
          "in": {
            "$cond": [
              {
                "$or": [
                  {
                    "$eq": [
                      "$$value",
                      null,
                    ],
                  },
                  {
                    "$lt": [
                      "$$this.priceUyu",
                      "$$value.priceUyu",
                    ],
                  },
                ],
              },
              "$$this",
              "$$value",
            ],
          },
          "initialValue": null,
          "input": "$offers",
        },
      },
      "parkingSpaces": {
        "$max": "$offers.parkingSpaces",
      },
      "petsAllowed": {
        "$cond": [
          {
            "$in": [
              true,
              "$offers.petsAllowed",
            ],
          },
          true,
          null,
        ],
      },
      "priceDrop": {
        "$cond": [
          {
            "$in": [
              "$priceDrop.listingId",
              "$offers.listingId",
            ],
          },
          "$priceDrop",
          "$$REMOVE",
        ],
      },
      "sources": {
        "$setUnion": [
          "$offers.source",
          [],
        ],
      },
      "terms": {
        "$reduce": {
          "in": {
            "$setUnion": [
              "$$value",
              {
                "$cond": [
                  {
                    "$isArray": "$$this.terms",
                  },
                  "$$this.terms",
                  [],
                ],
              },
            ],
          },
          "initialValue": [],
          "input": "$offers",
        },
      },
    },
  },
  {
    "$set": {
      "currency": "$matchingOffer.currency",
      "price": "$matchingOffer.price",
      "priceUyu": "$matchingOffer.priceUyu",
    },
  },
]
`;

