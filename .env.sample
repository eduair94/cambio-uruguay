# Telegram channel used by the 5-minute quote-change ledger. Unchanged checks
# never write to Mongo or send a message.
TELEGRAM_BOT_TOKEN=
TELEGRAM_RATE_CHANGES_CHANNEL_ID=

# Prex USD scrape (cambiomoneda page). PREX_USER_ID = your numeric account id (URL segment).
# PREX_SESSION_ID = seed PHPSESSID cookie; the scraper auto-refreshes it (cached to prex_session.txt).
PREX_USER_ID=1234
PREX_SESSION_ID=your_phpsessid_cookie
# Auto cookie refresh: web login mints a fresh PHPSESSID when the cookie expires.
# PREX_LOGIN_USER = documento (CI, no dots/dashes); PREX_LOGIN_PASSWORD = web password.
# PREX_OTP_URL = endpoint returning the emailed 6-digit code as JSON {code, receivedAt}.
PREX_LOGIN_USER=12345678
PREX_LOGIN_PASSWORD=your_web_password
PREX_OTP_URL=https://your-mailbox-endpoint/code?to=you@example.com&want=code

# OCA USD scrape (authenticated Mi Cuenta quotation table).
# Use the CI without dots/dashes and the Mi Cuenta/App password.
# A successful login is cached in gitignored oca_session.json and reused until it expires.
OCA_LOGIN_USER=12345678
OCA_LOGIN_PASSWORD=your_web_password
# OCA_SESSION_CACHE_PATH=oca_session.json

# Santander USD scrape (Supernet).
# Recommended: use the CI without dots/dashes plus the web password. The scraper
# logs in only when its cached session expires; the cache is gitignored.
SANTANDER_LOGIN_USER=12345678
SANTANDER_LOGIN_PASSWORD=your_web_password
# Optional portal identifier prefix (Uruguay CI default)
SANTANDER_PORTAL_DOCUMENT_PREFIX=858-01
# Optional overrides for non-standard logins:
# SANTANDER_USERNAME=858-1-12345678
# SANTANDER_LOGIN_KIND=person
# SANTANDER_COUNTRY_DOCUMENT_PREFIX=858-1
# Manual-session fallback: copy BOTH values from the same authenticated request.
# Do not combine stale manual tokens with credential mode.
# SANTANDER_AUTH_TOKEN=
# SANTANDER_SESSION_ID=
# SANTANDER_APP_VERSION=10.9.3
# SANTANDER_SESSION_CACHE_PATH=santander_session.json
# SANTANDER_DISABLE_SESSION_CACHE=false

# Other scraper/API credentials. Never commit real values.
POSITIONSTACK_API_KEY=your_positionstack_access_key
CAMBIO_SIR_INSTANCE=your_wix_instance_token

# Scotiabank USD/EUR/UI scrape (authenticated Scotia en Línea widget).
# Use the regular Scotia en Línea user (CI) and password. A successful
# session is cached in gitignored scotiabank_session.json until it expires.
SCOTIABANK_LOGIN_USER=12345678
SCOTIABANK_LOGIN_PASSWORD=your_web_password
# SCOTIABANK_SESSION_CACHE_PATH=scotiabank_session.json

# AI Insights Configuration (OpenAI-compatible API)
# Latest wormgpt model as of 2026-06: wormv5.1 (also: wormv5.0, wormv4.5, worm-coder, wormv-auto)
AI_BASE_URL=https://wormgpt.checkleaked.com/v1
AI_API_KEY=your_api_key_here
AI_MODEL=wormv5.1

# Weekly r/CharruaDevs desktop-chair evidence job (`npm run sync_chair_tiers -- --force`).
# APP_MONGO_URI must point to the Nuxt app database, never the root `cambio-uy` database.
APP_MONGO_URI=mongodb+srv://user:password@example.mongodb.net/app-db
REDDIT_CLIENT_ID=your_reddit_script_app_client_id
REDDIT_CLIENT_SECRET=your_reddit_script_app_client_secret
REDDIT_USER_AGENT=cambio-uruguay-chair-research/1.0
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite
# Pace provider calls; the PM2 chair job sets this to 10000.
GEMINI_MIN_INTERVAL_MS=10000
# Quota-independent chair refresh: exact supported models, sentiment, and themes are extracted
# locally. Leave at 0 to keep Gemini enrichment enabled.
CHAIR_ANALYSIS_LOCAL_ONLY=0

# Daily Uruguay chair-price directory (`npm run sync_chairs`).
# Defaults target the existing Mercado Libre and Facebook scraper services; override for local or
# replacement services. Storefront adapters use public sitemaps/product JSON and need no secret.
CHAIR_ML_API=http://127.0.0.1:9656/mercadolibre
CHAIR_FB_API=http://127.0.0.1:9657/facebook/marketplace
CHAIR_FB_ENABLED=1
CHAIR_FB_LOCATION=montevideo
CHAIR_RATE_API=https://api.cambio-uruguay.com
# Optional deterministic override for offline refreshes, expressed as UYU per USD.
# CHAIR_USD_UYU=40
CHAIR_ML_MAX_PAGES=4
CHAIR_FB_LIMIT=40
CHAIR_STORE_MAX_PDP=260
CHAIR_GLOBAL_MODELS=24
CHAIR_REVIEW_LIMIT=40
CHAIR_HTTP_TIMEOUT_MS=20000
CHAIR_HOST_GAP_MS=350

# Image-based identification for listings whose title names no chair (mostly Facebook Marketplace).
# Uses the cheapest Gemini model with the product photo; guessed brands are restricted to makers
# that actually sell in Uruguay, and every guess is cached per image so it is paid for once.
CHAIR_VISION_ENABLED=1
CHAIR_VISION_LIMIT=40
CHAIR_VISION_MIN_CONFIDENCE=0.7

# Public site-analytics snapshot (`npm run sync_site_analytics`, pm2 `currency-site-analytics`).
# Feeds /estadisticas-del-sitio. Full setup: docs/analytics/GA4_DATA_API.md
# NUMERIC GA4 property id (Admin -> Property Settings). NOT the G-XXXXXXXXXX measurement id.
GA4_PROPERTY_ID=123456789
# Service account with the Viewer role on that property. Either paste the two fields of its JSON
# key (the private key keeps its literal \n escapes) ...
GA4_CLIENT_EMAIL=analytics-reader@your-project.iam.gserviceaccount.com
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# ... or point at the JSON file. If neither is set, the repo's existing sheet_key.json is tried,
# which works if you granted THAT service account Viewer on the property instead.
# GA4_KEY_FILE=./ga4_key.json
# Timezone used to compute the reporting window. The property's own timezone still wins in the
# stored snapshot; this only decides which calendar days are asked for.
GA4_TIMEZONE=America/Montevideo

# --- Anti-bot (FlareSolverr) -------------------------------------------------
# Some casas sit behind Cloudflare bot-fight, which blocks on the client's TLS
# fingerprint rather than its IP — every proxy gets 403 alike, so rotating
# addresses does not help. FlareSolverr drives a real browser and returns the
# solved HTML. Comma-separated list of /v1 endpoints; the scraper shuffles them
# and gives up within one origin's slice of the sync run.
# Leave unset to disable: affected scrapers fall back to their proxied request.
FLARESOLVERR_URLS=http://10.0.0.1:8192/v1,http://10.0.0.2:8192/v1

# --- Claude (endpoint privado en el 104) -------------------------------------
# `claude-agent-api`: Claude Code headless corriendo contra la SUSCRIPCIÓN del mantenedor, en
# 127.0.0.1:9310 de la misma caja que estos crons. Contrato completo en
# /root/claude-agent-api/INTEGRACION.md.
#
# Es el proveedor de texto por defecto del bot de Reddit (juez, redactor, investigación de huecos).
# Gemini queda como respaldo automático.
#
# OJO: NO tiene embeddings. Anthropic no publica endpoint de embeddings — classes/rag/embed.ts se
# queda en Gemini para siempre. Es una capacidad que no existe, no una opción de configuración.
CLAUDE_AGENT_URL=http://127.0.0.1:9310
CLAUDE_AGENT_API_KEY=
# La cuota son 200 llamadas por día y son las MISMAS que consume el uso interactivo del dueño de la
# cuenta. Por debajo de este resto, los jobs se abstienen y el día es para la persona.
CLAUDE_AGENT_MIN_REMAINING=60
# Raíz del sandbox del agente. Ahí se deja la imagen de un post para que la lea con `Read` (el
# endpoint no tiene campo de imagen; tiene un workspace confinado). Fuera del 104 no existe y la
# ruta de visión degrada sola a Gemini inline.
CLAUDE_AGENT_WORKSPACES=/root/claude-agent-api/workspaces
# Fijar proveedor de texto: `claude` | `gemini`. Vacío = Claude si está configurado.
# Fijarlo sirve para reproducir una respuesta rara: "ayer contestó cualquier cosa" no se investiga
# si no sabés qué modelo la escribió.
AI_TEXT_PROVIDER=

# --- RAG del sitio + bot de Reddit -------------------------------------------
# Índice vectorial de cambio-uruguay.com (`npm run sync_rag_index`, pm2 `currency-rag-index`) y el
# bot que responde en subreddits uruguayos (`currency-reddit-bot`).
#
# El índice y el ledger del bot viven en la Mongo de la APP (APP_MONGO_URI → localhost:27017 en el
# servidor de deploy), no en la del backend. Sin APP_MONGO_URI los cuatro jobs salen con error en
# vez de escribir en la base equivocada.

# De dónde se lee el corpus. Sólo cambialo para indexar un entorno de pruebas.
SITE_BASE_URL=https://cambio-uruguay.com
# Modelo de embeddings. `gemini-embedding-001` es el GA verificado contra la API; a 768 dims
# devuelve vectores SIN normalizar y el código los normaliza siempre (ver classes/rag/embed.ts).
RAG_EMBED_MODEL=gemini-embedding-001
RAG_EMBED_DIMS=768
# LA RESTRICCIÓN QUE MANDA: los embeddings se miden POR DÍA y este proyecto está en free tier para
# ese endpoint. Medido contra la API real el 2026-08-17:
#   EmbedContentRequestsPerDayPerUserPerProjectPerModel-FreeTier = 1000
# y cada ítem de un batch cuenta como un request. Que generateContent se comporte como pago no
# implica que los embeddings lo sean.
#
# El corpus tiene ~3.400 chunks embebibles, así que el primer índice NO entra en un día con free
# tier. El diseño lo asume: las páginas programáticas no se embeben nunca (van sólo por el brazo
# léxico), el indexador gasta un presupuesto y para, y lo que quedó se toma en la corrida siguiente
# sin repetir nada. El índice converge en ~5 días y después cuesta casi nada por día.
#
# Con facturación habilitada para embeddings esto sobra: son ~1,5 M de tokens una sola vez.
#
# CAPACIDAD: la cuota es por PROYECTO, así que dos claves de dos proyectos son dos cupos. Listalas
# separadas por coma acá y el indexador rota sola cuando una se queda sin cupo diario. Sin esta
# variable se usan las claves distintas que ya haya en el entorno (GEMINI_API_KEY,
# NUXT_GEMINI_API_KEY), que en esta caja eran dos y se estaba gastando una sola.
GEMINI_EMBED_KEYS=
# El presupuesto se multiplica solo por la cantidad de claves (800 de cada 1.000; el resto son las
# consultas del bot). Setealo a mano sólo para pisar ese cálculo — por ejemplo alto, con facturación
# habilitada, para que el primer índice se arme de una.
RAG_EMBED_DAILY_BUDGET=
# PACE es el respiro entre lotes. COOLDOWN es lo que se espera cuando un lote volvió vacío — sin
# eso, el siguiente lote entra en la misma ventana cerrada y se pierde la corrida entera, no un lote.
RAG_EMBED_PACE_MS=250
RAG_EMBED_COOLDOWN_MS=45000

# --- Bot de Reddit: DOS puertas ---
# Con REDDIT_BOT_ENABLED sin setear, el bot corre el pipeline entero y no publica nada. Es el
# estado correcto hasta haber mirado unos días de dry-run: las credenciales van a estar en el VPS
# antes de que los umbrales estén calibrados, y desplegar el archivo no puede ser lo que arranca a
# hablarle a desconocidos.
REDDIT_BOT_ENABLED=0
REDDIT_BOT_DRY_RUN=1

# App de tipo "script" en https://www.reddit.com/prefs/apps, con la cuenta del bot como developer.
# Son credenciales SEPARADAS de REDDIT_CLIENT_ID/SECRET (esas son app-only y sólo leen): postear
# necesita un token de USUARIO, y separarlas evita que un error acá rompa los pipelines de lectura.
REDDIT_BOT_CLIENT_ID=
REDDIT_BOT_CLIENT_SECRET=
REDDIT_BOT_USERNAME=
REDDIT_BOT_PASSWORD=
# Alternativa al usuario/contraseña, y la única opción si la cuenta tiene 2FA (el grant `password`
# exigiría pegarle el OTP a la contraseña, cosa imposible desde un cron).
REDDIT_BOT_REFRESH_TOKEN=
# Reddit bloquea User-Agents genéricos. Si lo dejás vacío se arma uno con el username.
REDDIT_BOT_USER_AGENT=

# La cuenta SOLO COMENTA. Abrir hilos esta cerrado en el codigo (post.ts se niega a llamar a
# /api/submit) y esto es lo unico que lo abre. La cuenta anterior abria un hilo por dia y termino
# baneada permanentemente del unico sub donde podia escribir. No lo prendas sin una razon nueva.
REDDIT_BOT_ALLOW_POSTS=0
# La aclaracion de que es un bot vive en la BIO del perfil, no al pie de cada comentario. Esto exige
# que la bio de verdad lo diga -"automatizada" + el nombre del sitio- antes de publicar; si no lo
# dice, la corrida se detiene y avisa. `0` solo para depurar.
REDDIT_BOT_REQUIRE_BIO_DISCLOSURE=1

# Estos siete son TODOS los subs uruguayos que valen: se midieron 28 candidatos contra la API y el
# resto o no existen, o contestan 403, o tienen cero hilos por semana. De los siete, r/AskUruguayan
# y r/CharruaDevs los frena subrules.ts (ban y reglas), asi que en la practica son cuatro.
REDDIT_BOT_SUBS=uruguay,Burises,UruguayFinanzas,LegalUruguay,AskUruguayan,monte_video,CharruaDevs
REDDIT_BOT_FETCH_LIMIT=50
# Paginas de /new por sub, de 100 hilos cada una. Con la ventana en una semana, UNA pagina no
# alcanza y falla en silencio: r/uruguay publica mas de 100 hilos por semana, asi que el bot veria
# los ultimos dias y concluiria que no hay mas. Corta solo al salir de la ventana.
REDDIT_BOT_FETCH_PAGES=4
# Cuantos comentarios puede dejar UNA corrida. Es un limite de RAFAGA, no de volumen: entre uno y
# otro la corrida duerme REDDIT_BOT_MIN_GAP_MIN con jitter y vuelve a leer los cupos. El volumen lo
# fijan MAX_PER_DAY y MAX_PER_SUB_PER_DAY.
REDDIT_BOT_MAX_PER_RUN=5
# Horas UTC en las que no publica aunque el cron dispare. Uruguay es UTC-3, asi que 3..10 es de
# medianoche a las 8 de la manana. Vacio = sin horas de silencio.
REDDIT_BOT_QUIET_HOURS_UTC=3,4,5,6,7,8,9,10
# Cuántos hilos puede embeber una corrida. Sale del mismo cupo diario de 1.000 que el índice, y el
# bot corre 65 veces por día: sin tope, una mañana movida se come el presupuesto del indexador antes
# del mediodía y el índice queda a medio construir para siempre. Los que no entran los preselecciona
# el brazo léxico (gratis) y esperan doce minutos.
REDDIT_BOT_MAX_CANDIDATES=40
# Mirar la imagen que el post adjunta. Buena parte de estos hilos SON la captura —"me llegó esto,
# es normal?" sobre la foto de lo que cobró el courier— y el título solo no dice nada. Con Claude va
# por archivo en el workspace + tool Read; con Gemini va inline. `0` para apagarlo.
REDDIT_BOT_READ_IMAGES=1
# Leer los comentarios que el hilo YA tiene antes de redactar. Es lo que permite no repetir lo ya
# dicho y corregir lo que esta mal, que es lo mas util que se puede escribir en un hilo con
# respuestas. Esos comentarios NO cuentan como fuente: sus cifras no pueden aparecer en la nuestra.
REDDIT_BOT_READ_THREAD=1
# Ventana de edad del hilo: ni recién publicado (que los mods hagan lo suyo y OP termine de editar)
# ni viejo (nadie lee una respuesta de ayer).
REDDIT_BOT_MIN_AGE_MIN=15
REDDIT_BOT_MAX_AGE_HOURS=168
# Frenos. El de página importa más de lo que parece: tres respuestas seguidas linkeando lo mismo es
# el patrón que un moderador reconoce como spam aunque cada respuesta por separado esté bien.
REDDIT_BOT_MAX_PER_DAY=25
REDDIT_BOT_MAX_PER_SUB_PER_DAY=8
REDDIT_BOT_MIN_GAP_MIN=8
REDDIT_BOT_AUTHOR_COOLDOWN_DAYS=7
REDDIT_BOT_PAGE_COOLDOWN_DAYS=0
# Dos puertas independientes de relevancia. El coseno del mejor chunk dice "está cerca"; el margen
# sobre la segunda página dice "ganó UNA, no empataron cuatro" — un empate significa que cubrimos el
# tema pero no contestamos la pregunta, que es exactamente la definición de hueco de contenido.
#
# Ojo: el score RRF absoluto NO sirve de umbral. Con k=60 el máximo teórico de una página que gana
# los dos brazos es 2/61 ≈ 0,033, así que un "0.034" con cara de valor calibrado deja al bot mudo
# para siempre. Por eso el umbral compara en vez de medir.
REDDIT_BOT_MIN_COSINE=0.62
REDDIT_BOT_MIN_MARGIN=1.12
# Por encima de este coseno el margen se ignora y decide el juez: un empate con match flojo es un
# hueco de contenido, pero un empate con match fuerte significa que el sitio contesta la pregunta
# desde dos ángulos. Medido: "monotributo o unipersonal" da 0,741 con margen 1,04 porque hay dos
# páginas que de verdad la contestan.
REDDIT_BOT_STRONG_COSINE=0.72
REDDIT_BOT_MIN_JUDGE=0.7
# Corte automático: N respuestas borradas o con score bajo en 24 h y el bot se pausa solo.
REDDIT_BOT_BREAKER_NEGATIVES=3
REDDIT_BOT_BREAKER_PAUSE_HOURS=48

# --- Páginas generadas a partir de huecos de Reddit --------------------------
# Cuando 4+ hilos preguntan lo mismo y el sitio no lo contesta, `currency-content-gaps` investiga,
# escribe la página y la PUBLICA sola (push a main = deploy). Después el bot vuelve a esos hilos y
# los contesta con la página que se generó para ellos.
#
# No hay una persona entre esto y el sitio público, así que la verificación que haría esa persona
# está automatizada: la pregunta tiene que caer en una temática del sitio, cada fuente se descarga y
# tiene que devolver 200, CADA cifra de la página tiene que aparecer literal en el texto descargado,
# y el lint y los tests de la app tienen que pasar ANTES del push. Cualquiera de esas en rojo y no
# se publica nada — queda un borrador en docs/reddit-gaps/ para revisar a mano.
#
# Clon propio donde se escribe, se verifica y se commitea. NUNCA el checkout de deploy: los scripts
# de deploy hacen `git pull` ahí y archivos generados sueltos convierten el próximo deploy en un
# conflicto. Se prepara una sola vez:
#   git clone <repo> /root/cambio-uruguay-genpage
#   cd /root/cambio-uruguay-genpage/app && npm install --force
GENPAGE_WORKSPACE=/root/cambio-uruguay-genpage
# Sólo se usa si el clon no existe todavía.
GENPAGE_REMOTE=

# Investigar afuera lo que la página no cubre, antes de redactar la respuesta.
# Cuesta una llamada con búsqueda web por respuesta (≤6 por día). Lo que compra: el primer
# comentario real del bot salió cierto pero sin una sola cifra, porque la página no mencionaba el
# caso puntual que preguntaban y el redactor sólo puede usar números que estén en lo que recibió.
#
# NO afloja la regla. Lo que vuelve de la investigación es TEXTO DESCARGADO de URLs que pedimos
# nosotros y contestaron 200, y entra al mismo pool contra el que se verifica cada cifra. Una
# afirmación que el modelo recuerde y ninguna fuente sostenga sigue sin publicarse.
#
# Y tiene un segundo uso: lo que la investigación encuentra y la página no tenía queda anotado como
# faltante de esa página. Cuando dos personas distintas tropiezan con lo mismo, `currency-content-gaps`
# escribe la ampliación y la publica (en app/utils/generated/addenda.ts; la página no se edita).
REDDIT_BOT_RESEARCH_GAPS=1
