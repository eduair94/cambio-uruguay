# Telegram channel used by the 5-minute quote-change ledger. Unchanged checks
# never write to Mongo or send a message.
TELEGRAM_BOT_TOKEN=
TELEGRAM_RATE_CHANGES_CHANNEL_ID=

# Prex USD scrape (cambiomoneda page). PREX_USER_ID = your numeric account id (URL segment).
# PREX_SESSION_ID = seed PHPSESSID cookie; the scraper auto-refreshes it (cached to prex_session.txt).
PREX_USER_ID=1234
PREX_SESSION_ID=your_phpsessid_cookie
# Auto cookie refresh: web login mints a fresh PHPSESSID when the cookie expires.
# PREX_LOGIN_USER = documento (CI, no dots/dashes); PREX_LOGIN_PASSWORD = web password.
# PREX_OTP_URL = endpoint returning the emailed 6-digit code as JSON {code, receivedAt}.
PREX_LOGIN_USER=12345678
PREX_LOGIN_PASSWORD=your_web_password
PREX_OTP_URL=https://your-mailbox-endpoint/code?to=you@example.com&want=code

# OCA USD scrape (authenticated Mi Cuenta quotation table).
# Use the CI without dots/dashes and the Mi Cuenta/App password.
# A successful login is cached in gitignored oca_session.json and reused until it expires.
OCA_LOGIN_USER=12345678
OCA_LOGIN_PASSWORD=your_web_password
# OCA_SESSION_CACHE_PATH=oca_session.json

# Santander USD scrape (Supernet).
# Recommended: use the CI without dots/dashes plus the web password. The scraper
# logs in only when its cached session expires; the cache is gitignored.
SANTANDER_LOGIN_USER=12345678
SANTANDER_LOGIN_PASSWORD=your_web_password
# Optional portal identifier prefix (Uruguay CI default)
SANTANDER_PORTAL_DOCUMENT_PREFIX=858-01
# Optional overrides for non-standard logins:
# SANTANDER_USERNAME=858-1-12345678
# SANTANDER_LOGIN_KIND=person
# SANTANDER_COUNTRY_DOCUMENT_PREFIX=858-1
# Manual-session fallback: copy BOTH values from the same authenticated request.
# Do not combine stale manual tokens with credential mode.
# SANTANDER_AUTH_TOKEN=
# SANTANDER_SESSION_ID=
# SANTANDER_APP_VERSION=10.9.3
# SANTANDER_SESSION_CACHE_PATH=santander_session.json
# SANTANDER_DISABLE_SESSION_CACHE=false

# Other scraper/API credentials. Never commit real values.
POSITIONSTACK_API_KEY=your_positionstack_access_key
CAMBIO_SIR_INSTANCE=your_wix_instance_token

# Scotiabank USD/EUR/UI scrape (authenticated Scotia en Línea widget).
# Use the regular Scotia en Línea user (CI) and password. A successful
# session is cached in gitignored scotiabank_session.json until it expires.
SCOTIABANK_LOGIN_USER=12345678
SCOTIABANK_LOGIN_PASSWORD=your_web_password
# SCOTIABANK_SESSION_CACHE_PATH=scotiabank_session.json

# AI Insights Configuration (OpenAI-compatible API)
# Latest wormgpt model as of 2026-06: wormv5.1 (also: wormv5.0, wormv4.5, worm-coder, wormv-auto)
AI_BASE_URL=https://wormgpt.checkleaked.com/v1
AI_API_KEY=your_api_key_here
AI_MODEL=wormv5.1

# Weekly r/CharruaDevs desktop-chair evidence job (`npm run sync_chair_tiers -- --force`).
# APP_MONGO_URI must point to the Nuxt app database, never the root `cambio-uy` database.
APP_MONGO_URI=mongodb+srv://user:password@example.mongodb.net/app-db
REDDIT_CLIENT_ID=your_reddit_script_app_client_id
REDDIT_CLIENT_SECRET=your_reddit_script_app_client_secret
REDDIT_USER_AGENT=cambio-uruguay-chair-research/1.0
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite
# Pace provider calls; the PM2 chair job sets this to 10000.
GEMINI_MIN_INTERVAL_MS=10000
# Quota-independent chair refresh: exact supported models, sentiment, and themes are extracted
# locally. Leave at 0 to keep Gemini enrichment enabled.
CHAIR_ANALYSIS_LOCAL_ONLY=0

# Daily Uruguay chair-price directory (`npm run sync_chairs`).
# Defaults target the existing Mercado Libre and Facebook scraper services; override for local or
# replacement services. Storefront adapters use public sitemaps/product JSON and need no secret.
CHAIR_ML_API=http://127.0.0.1:9656/mercadolibre
CHAIR_FB_API=http://127.0.0.1:9657/facebook/marketplace
CHAIR_FB_ENABLED=1
CHAIR_FB_LOCATION=montevideo
CHAIR_RATE_API=https://api.cambio-uruguay.com
# Optional deterministic override for offline refreshes, expressed as UYU per USD.
# CHAIR_USD_UYU=40
CHAIR_ML_MAX_PAGES=4
CHAIR_FB_LIMIT=40
CHAIR_STORE_MAX_PDP=260
CHAIR_GLOBAL_MODELS=24
CHAIR_REVIEW_LIMIT=40
CHAIR_HTTP_TIMEOUT_MS=20000
CHAIR_HOST_GAP_MS=350

# Image-based identification for listings whose title names no chair (mostly Facebook Marketplace).
# Uses the cheapest Gemini model with the product photo; guessed brands are restricted to makers
# that actually sell in Uruguay, and every guess is cached per image so it is paid for once.
CHAIR_VISION_ENABLED=1
CHAIR_VISION_LIMIT=40
CHAIR_VISION_MIN_CONFIDENCE=0.7

# Public site-analytics snapshot (`npm run sync_site_analytics`, pm2 `currency-site-analytics`).
# Feeds /estadisticas-del-sitio. Full setup: docs/analytics/GA4_DATA_API.md
# NUMERIC GA4 property id (Admin -> Property Settings). NOT the G-XXXXXXXXXX measurement id.
GA4_PROPERTY_ID=123456789
# Service account with the Viewer role on that property. Either paste the two fields of its JSON
# key (the private key keeps its literal \n escapes) ...
GA4_CLIENT_EMAIL=analytics-reader@your-project.iam.gserviceaccount.com
GA4_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# ... or point at the JSON file. If neither is set, the repo's existing sheet_key.json is tried,
# which works if you granted THAT service account Viewer on the property instead.
# GA4_KEY_FILE=./ga4_key.json
# Timezone used to compute the reporting window. The property's own timezone still wins in the
# stored snapshot; this only decides which calendar days are asked for.
GA4_TIMEZONE=America/Montevideo
